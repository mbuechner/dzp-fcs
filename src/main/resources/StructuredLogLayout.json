{
  "timestamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "level": {"$resolver": "level", "field": "name"},
  "logger": {"$resolver": "logger", "field": "name"},
  "thread": {"$resolver": "thread", "field": "name"},
  "requestId": {"$resolver": "mdc", "key": "requestId"},
  "message": {"$resolver": "message"},
  "exception": {
    "type": {"$resolver": "exception", "field": "className"},
    "message": {"$resolver": "exception", "field": "message"},
    "stackTrace": {
      "$resolver": "exception",
      "field": "stackTrace",
      "stackTrace": {"stringified": true}
    }
  }
}
