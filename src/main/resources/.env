# Solr endpoint of German newspaper portal 
DZP_FCS_SOLR_ENDPOINT=https://api.deutsche-digitale-bibliothek.de/2/search/index/newspaper-issues/select

# Application identification and contact details for DDB API requests
DZP_FCS_CLIENT_ID=dzp-fcs
DZP_FCS_CONTACT_EMAIL=m.buechner@dnb.de
DZP_FCS_CONTACT_URL=https://github.com/mbuechner/dzp-fcs

# One backend budget for queueing, all attempts, body reads and retry delays.
# Leave time to serialize and return SRU responses before the OpenShift route's 60s timeout.
DZP_FCS_BACKEND_CONNECT_TIMEOUT_SECONDS=10
DZP_FCS_BACKEND_READ_TIMEOUT_SECONDS=50
DZP_FCS_BACKEND_REQUEST_TIMEOUT_SECONDS=50
DZP_FCS_BACKEND_MAX_ATTEMPTS=3
DZP_FCS_BACKEND_MAX_CONCURRENT_REQUESTS=16
DZP_FCS_BACKEND_RETRY_DELAY_MILLIS=1000
DZP_FCS_BACKEND_MAX_RETRY_DELAY_MILLIS=10000
